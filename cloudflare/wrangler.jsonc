{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadar-private-watch-room",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WATCH_ROOM", "class_name": "WatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WatchRoom"] }
  ],
  "observability": { "enabled": true }
}
